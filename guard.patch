
diff --git a/awareness.odin b/awareness.odin
--- a/awareness.odin
+++ b/awareness.odin
@@ -7,10 +7,17 @@ Guard_Awareness_State :: enum u8 {
     ALERTED,
 }
 
+Last_Known_Source :: enum u8 {
+    NONE,
+    SIGHT,
+    SOUND,
+}
+
 Guard_Awareness :: struct {
     state: Guard_Awareness_State,
     suspicion: f32,
-    last_known_player_position: Mission_Point,
+    last_known_position: Mission_Point,
+    last_known_source: Last_Known_Source,
 }
 
 Awareness_Config :: struct {
@@ -32,6 +39,22 @@ guard_awareness_init :: proc() -> Guard_Awareness {
     }
 }
 
+// A heard noise creates suspicion, but never alerts the guard.
+// Call this before guard_awareness_update so visual detection can
+// override the sound-derived position during the same frame.
+guard_awareness_hear_noise :: proc(
+    awareness: ^Guard_Awareness,
+    noise_position: Mission_Point,
+) {
+    if awareness.state == .ALERTED {
+        return
+    }
+
+    awareness.state = .SUSPICIOUS
+    awareness.suspicion = 0
+    awareness.last_known_position = noise_position
+    awareness.last_known_source = .SOUND
+}
+
 // Updates one guard's awareness state.
 //
 // Suspicion builds while the player is visible and decays while hidden.
@@ -52,13 +75,13 @@ guard_awareness_update :: proc(
     // Alerted guards retain their alert state, but continue updating
     // the target whenever they see the player again.
     if awareness.state == .ALERTED {
         if sees_player {
-            awareness.last_known_player_position = player_position
+            awareness.last_known_position = player_position
+            awareness.last_known_source = .SIGHT
         }
         return
     }
 
     if sees_player {
-        awareness.last_known_player_position = player_position
+        awareness.last_known_position = player_position
+        awareness.last_known_source = .SIGHT
 
         if config.build_duration <= 0 {
             awareness.suspicion = 1
@@ -71,6 +94,12 @@ guard_awareness_update :: proc(
             awareness.state = .SUSPICIOUS
         }
     } else {
+        // A noise investigation remains active until the guard reaches
+        // the reported location and completes its search.
+        if awareness.last_known_source == .SOUND {
+            awareness.state = .SUSPICIOUS
+            return
+        }
+
         if config.decay_duration <= 0 {
             awareness.suspicion = 0
         } else {
@@ -81,6 +110,7 @@ guard_awareness_update :: proc(
         if awareness.suspicion <= 0 {
             awareness.suspicion = 0
             awareness.state = .UNAWARE
+            awareness.last_known_source = .NONE
         } else {
             awareness.state = .SUSPICIOUS
         }
diff --git a/guards.odin b/guards.odin
--- a/guards.odin
+++ b/guards.odin
@@ -126,7 +126,7 @@ guard_investigate_update :: proc(
         return
     }
 
-    target := guard.awareness.last_known_player_position
+    target := guard.awareness.last_known_position
 
     dx := target.x - guard.position.x
     dy := target.y - guard.position.y
@@ -149,6 +149,17 @@ guard_investigate_update :: proc(
 
             if guard.searching {
                 guard_search_update(guard, dt)
+
+                // A sound investigation ends after the guard has
+                // searched the reported location.
+                if guard.search_complete &&
+                    guard.awareness.state == .SUSPICIOUS &&
+                    guard.awareness.last_known_source == .SOUND {
+                    guard.awareness.state = .UNAWARE
+                    guard.awareness.suspicion = 0
+                    guard.awareness.last_known_source = .NONE
+                    guard.search_complete = false
+                }
             }
         }
         return
@@ -187,7 +198,10 @@ guard_update :: proc(guards: []Guard, mission: ^Mission, dt: f32) {
     }
     for i in 0..<len(guards) {
         guard := &guards[i]
-        if guard.awareness.state == .ALERTED {
+        if guard.awareness.state == .ALERTED ||
+            (guard.awareness.state == .SUSPICIOUS &&
+             guard.awareness.last_known_source == .SOUND) {
             guard_investigate_update(guard, mission, dt)
             continue
         }
